      return()
    }
    
    cpty <- hover$counterparty
    qtr <- hover$quarter
    current_val <- as.numeric(hover$current_value)
    if (is.na(current_val)) current_val <- 0
    
    baseline_val <- 0
    if (!is.null(rv$adj_baseline[[iss]]) && nrow(rv$adj_baseline[[iss]]) > 0) {
      baseline_row <- rv$adj_baseline[[iss]] %>%
        filter(counterparty_sector == cpty, qtr == !!qtr)
      if (nrow(baseline_row) > 0) baseline_val <- sum(baseline_row$baseline, na.rm = TRUE)
    }
    
    delta <- current_val - baseline_val
    
    notes_text <- ""
    if (!is.null(rv$notes_path) && file.exists(rv$notes_path)) {
      notes_log <- tryCatch(read_notes_log(rv$notes_path), error = function(e) tibble())
      if (nrow(notes_log) > 0) {
