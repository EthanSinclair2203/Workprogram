  output$tbl_adj_resid <- renderDT({
    iss <- selected_iss()
    cl <- current_levels()
    w <- tryCatch(revision_win(), error = function(e) NULL)
    
    if (is.null(iss) || iss == "" || is.null(cl) || is.null(w)) {
      return(datatable(data.frame(Residual = "..."), options = list(dom = "t"), rownames = FALSE))
    }
    
    adj_long <- rv$adj_state[[iss]]
    
    source_df <- cl %>%
      filter(issuer_sector == iss) %>%
      filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
      mutate(qtr = parse_quarter_label(qtr)) %>%
      mutate(qtr_end = qtr_end_from_mmm_yy(qtr)) %>%
      filter(qtr_end >= w$start & qtr_end <= w$end)
    
    if (nrow(source_df) == 0) {
      return(datatable(data.frame(Residual = "N/A"), options = list(dom = "t"), rownames = FALSE))
    }
    
    issuance <- source_df %>%
      filter(counterparty_sector == "000") %>%
      group_by(qtr, qtr_end) %>%
      summarise(issuance = sum(value, na.rm = TRUE), .groups = "drop")
    
    holders_source <- source_df %>%
      filter(counterparty_sector != "000") %>%
      group_by(qtr, qtr_end) %>%
      summarise(holders = sum(value, na.rm = TRUE), .groups = "drop")
    
    source_resid <- issuance %>%
      left_join(holders_source %>% select(qtr, holders), by = "qtr") %>%
      mutate(
        holders = coalesce(holders, 0),
        source_residual = issuance - holders
      )
    
    if (!is.null(adj_long) && nrow(adj_long) > 0) {
      holder_adj <- adj_long %>%
        filter(counterparty_sector != "000") %>%
        mutate(qtr = parse_quarter_label(qtr)) %>%
        mutate(qtr_end = qtr_end_from_mmm_yy(qtr)) %>%
        filter(qtr_end >= w$start & qtr_end <= w$end) %>%
        group_by(qtr) %>%
        summarise(total_adj = sum(adj_delta, na.rm = TRUE), .groups = "drop")
    } else {
      holder_adj <- data.frame(qtr = character(), total_adj = numeric())
    }
    
    adj_resid <- source_resid %>%
      left_join(holder_adj, by = "qtr") %>%
      mutate(
        total_adj = coalesce(total_adj, 0),
        adj_residual = round(source_residual + total_adj, 0)
      )
    
    result <- data.frame(Type = "Remaining", Sector = "Unallocated")
    qtr_order <- adj_resid %>% arrange(qtr_end) %>% pull(qtr)
    
    for (q in qtr_order) {
      val <- adj_resid %>% filter(qtr == q) %>% pull(adj_residual)
      result[[q]] <- if (length(val) > 0) val else NA
    }
    
    datatable(result,
              extensions = 'FixedColumns',
              selection = "none",
              options = list(
                scrollX = TRUE, paging = FALSE, dom = "t", autoWidth = FALSE,
                fixedColumns = list(leftColumns = 2),
                initComplete = scroll_right_callback
              ),
              rownames = FALSE, width = "100%")
  })
  
