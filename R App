  observeEvent(input$tbl_adj_cell_edit, {
    info <- input$tbl_adj_cell_edit
    req(info)
    
    issuer <- selected_iss()
    if (is.null(issuer)) return()
    
    adj_long <- rv$adj_state[[issuer]]
    if (is.null(adj_long) || nrow(adj_long) == 0) return()
    
    mat <- build_adj_matrix(adj_long, issuer)
    
    r <- info$row
    c <- info$col + 1
    v <- suppressWarnings(as.numeric(info$value))
    if (is.na(v)) v <- 0
    
    if (c < 1 || c > ncol(mat)) return()
    
    colname <- names(mat)[c]
    
    if (colname %in% c("Type", "Sector", "instrument", "counterparty_sector")) return()
    
    row_data <- mat[r, ]
    row_cpty <- as.character(row_data$counterparty_sector)
    
    if (row_cpty == "000") {
      showNotification("Cannot edit issuance rows", type = "warning")
      return()
    }
    
    row_instrument <- as.character(row_data$instrument)
    qtr <- colname
    
    idx <- which(
      adj_long$instrument == row_instrument &
        adj_long$counterparty_sector == row_cpty &
        adj_long$qtr == qtr
    )
    
    if (length(idx) == 1) {
      adj_long$adj_delta[idx] <- v
      inst_class <- adj_long$inst_class[idx]
      
      append_adjustment(rv$log_path, inst_class, row_instrument, issuer,
                        row_cpty, qtr, v)
      
      rv$adj_state[[issuer]] <- adj_long
      
      new_mat <- build_adj_matrix(adj_long, issuer)
      proxy <- dataTableProxy("tbl_adj")
      replaceData(proxy, new_mat, resetPaging = FALSE, rownames = FALSE)
      
      mark_changed_cells()
      showNotification(paste("Updated", qtr, ":", v), type = "message", duration = 2)
    }
  }, ignoreInit = TRUE)
  
  observeEvent(input$paste_event, {
    ev <- input$paste_event
    req(ev$row, ev$col, ev$text)
    
    issuer <- selected_iss()
    if (is.null(issuer) || !issuer %in% issuers()) return()
    
    adj_long <- rv$adj_state[[issuer]]
    if (is.null(adj_long) || nrow(adj_long) == 0) return()
    
    mat <- build_adj_matrix(adj_long, issuer)
    
    start_r <- as.integer(ev$row)
    start_c <- as.integer(ev$col)
    
    lines <- strsplit(ev$text, "\r\n|\n|\r")[[1]]
    lines <- lines[nzchar(lines)]
    grid <- lapply(lines, function(line) strsplit(line, "\t")[[1]])
    
    updates_made <- 0
    
    for (i in seq_along(grid)) {
      for (j in seq_along(grid[[i]])) {
        rr <- start_r + (i - 1)
        cc <- start_c + (j - 1)
        
        if (rr < 1 || rr > nrow(mat) || cc < 1 || cc > ncol(mat)) next
        
        colname <- names(mat)[cc]
        if (colname %in% c("Type", "Sector", "instrument", "counterparty_sector")) next
        
        row_data <- mat[rr, ]
        row_cpty <- as.character(row_data$counterparty_sector)
        if (row_cpty == "000") next
        
        v <- suppressWarnings(as.numeric(grid[[i]][j]))
        if (is.na(v)) v <- 0
        
        row_instrument <- as.character(row_data$instrument)
        qtr <- colname
        
        idx <- which(
          adj_long$instrument == row_instrument &
            adj_long$counterparty_sector == row_cpty &
            adj_long$qtr == qtr
        )
        
        if (length(idx) == 1) {
          adj_long$adj_delta[idx] <- v
          inst_class <- adj_long$inst_class[idx]
          append_adjustment(rv$log_path, inst_class, row_instrument, issuer,
                            row_cpty, qtr, v)
          updates_made <- updates_made + 1
        }
      }
    }
    
    rv$adj_state[[issuer]] <- adj_long
    
    new_mat <- build_adj_matrix(adj_long, issuer)
    proxy <- dataTableProxy("tbl_adj")
    replaceData(proxy, new_mat, resetPaging = FALSE, rownames = FALSE)
    
    mark_changed_cells()
    
    if (updates_made > 0) showNotification(paste(updates_made, "cells updated"), type = "message")
  }, ignoreInit = TRUE)
