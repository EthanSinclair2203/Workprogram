server <- function(input, output, session) {
  
  rv <- reactiveValues(
    current_data = NULL,
    old_data = NULL,
    files_loaded = character(),
    log_path = DEFAULT_LOG_PATH,
    notes_path = NULL,
    adj_state = list(),
    adj_baseline = list(),
    snapshot_dir = NULL,
    viewing_snapshot = FALSE,
    snapshot_data = NULL,
    snapshot_metadata = NULL,
    notes_refresh = NULL
  )
  
  # -------------------------
  # Data Loading
  # -------------------------
  
  observeEvent(input$load_folder, {
    req(input$folder_path)
    
    if (!dir.exists(input$folder_path)) {
      showNotification("Folder does not exist!", type = "error")
      return()
    }
    
    showNotification("Loading workbooks...", type = "message", duration = NULL, id = "loading")
    
    tryCatch({
      data <- load_all_workbooks(input$folder_path)
      
      rv$current_data <- data$current
      rv$old_data <- data$old
      
      rv$files_loaded <- data$files
      rv$log_path <- file.path(input$folder_path, "adjustments_log.csv")
      rv$notes_path <- file.path(input$folder_path, "notes_log.csv")
      rv$snapshot_dir <- file.path(input$folder_path, "snapshots")
      
      rv$viewing_snapshot <- FALSE
      rv$snapshot_data <- NULL
      rv$snapshot_metadata <- NULL
      
      removeNotification(id = "loading")
      showNotification(paste("Loaded", length(data$files), "file(s)"), type = "message")
      
      rebuild_adj_state()
      
    }, error = function(e) {
      removeNotification(id = "loading")
      showNotification(paste("Error:", e$message), type = "error")
    })
  })
  
  observeEvent(input$upload_file, {
    req(input$upload_file)
    
    showNotification("Loading workbook...", type = "message", duration = NULL, id = "loading")
    
    tryCatch({
      data <- load_workbook(input$upload_file$datapath)
      
      rv$current_data <- data$current
      rv$old_data <- data$old
      
      rv$files_loaded <- input$upload_file$name
      rv$snapshot_dir <- file.path(dirname(rv$log_path), "snapshots")
      rv$notes_path <- file.path(dirname(rv$log_path), "notes_log.csv")
      
      rv$viewing_snapshot <- FALSE
      rv$snapshot_data <- NULL
      rv$snapshot_metadata <- NULL
      
      removeNotification(id = "loading")
      showNotification("Workbook loaded successfully!", type = "message")
      
      rebuild_adj_state()
      
    }, error = function(e) {
      removeNotification(id = "loading")
      showNotification(paste("Error:", e$message), type = "error")
    })
  })
  
  # -------------------------
  # Derived Data
  # -------------------------
  
  current_levels <- reactive({ rv$current_data })
  old_levels <- reactive({ rv$old_data })
  
  issuers <- reactive({
    req(current_levels())
    sort(setdiff(unique(current_levels()$issuer_sector), "000"))
  })
  
  edit_qtr <- reactive({
    req(current_levels())
    qtrs <- unique(current_levels()$qtr)
    valid_qtrs <- qtrs[safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtrs)]
    valid_qtrs <- parse_quarter_label(valid_qtrs)
    
    if (length(valid_qtrs) == 0) return(NULL)
    
    qtr_dates <- qtr_end_from_mmm_yy(valid_qtrs)
    valid_qtrs[which.max(qtr_dates)]
  })
  
  revision_win <- reactive({
    req(edit_qtr())
    edit_end <- qtr_end_from_mmm_yy(edit_qtr())
    revision_window(edit_end)
  })
  
  # -------------------------
  # Adjustments State Management
  # -------------------------
  
  rebuild_adj_state <- function() {
    req(current_levels(), issuers(), edit_qtr())
    
    w <- revision_win()
    
    adj_latest <- latest_adjustments(read_adjustments_log(rv$log_path))
    
    for (iss in issuers()) {
      src <- current_levels() %>%
        filter(issuer_sector == iss) %>%
        filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
        mutate(qtr = parse_quarter_label(qtr)) %>%
        mutate(qtr_end = qtr_end_from_mmm_yy(qtr)) %>%
        filter(qtr_end >= w$start, qtr_end <= w$end)
      
      if (nrow(src) == 0) {
        rv$adj_state[[iss]] <- tibble(
          inst_class = character(), instrument = character(),
          issuer_sector = character(), counterparty_sector = character(),
          qtr = character(), adj_delta = double()
        )
        rv$adj_baseline[[iss]] <- tibble(
          inst_class = character(), instrument = character(),
          issuer_sector = character(), counterparty_sector = character(),
          qtr = character(), baseline = double()
        )
        next
      }
      
      scope <- src %>%
        select(inst_class, instrument, issuer_sector, counterparty_sector, qtr) %>%
        distinct()
      
      grid_long <- scope %>%
        left_join(
          adj_latest %>% filter(issuer_sector == iss),
          by = c("inst_class", "instrument", "issuer_sector", "counterparty_sector", "qtr")
        ) %>%
        mutate(
          adj_delta = if_else(counterparty_sector == "000", 0, coalesce(adj_delta, 0))
        )
      
      rv$adj_state[[iss]] <- grid_long
      
      baseline_long <- grid_long %>%
        select(inst_class, instrument, issuer_sector, counterparty_sector, qtr, adj_delta) %>%
        rename(baseline = adj_delta)
      
      rv$adj_baseline[[iss]] <- baseline_long
    }
  }
  
