}

build_residual_row <- function(source_data, target_issuer) {
  if (is.null(source_data) || nrow(source_data) == 0) {
    return(data.frame(Type = "Residual", Sector = ""))
  }
  
  df <- source_data %>%
    filter(issuer_sector == target_issuer) %>%
    filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
    mutate(qtr = parse_quarter_label(qtr)) %>%
    mutate(qtr_end = qtr_end_from_mmm_yy(qtr))
  
  qtr_order <- df %>% distinct(qtr, qtr_end) %>% arrange(qtr_end) %>% pull(qtr)
  
  issuance <- df %>%
    filter(counterparty_sector == "000") %>%
    group_by(qtr) %>%
    summarise(issuance = sum(value, na.rm = TRUE), .groups = "drop")
  
  holders <- df %>%
    filter(counterparty_sector != "000") %>%
    group_by(qtr) %>%
    summarise(holders = sum(value, na.rm = TRUE), .groups = "drop")
  
  residuals <- issuance %>%
    left_join(holders, by = "qtr") %>%
    mutate(
      holders = coalesce(holders, 0),
      residual = round(issuance - holders, 2)
    )
  
  result <- data.frame(Type = "Residual", Sector = "")
  for (q in qtr_order) {
    val <- residuals %>% filter(qtr == q) %>% pull(residual)
    result[[q]] <- if (length(val) > 0) val else NA
  }
  result
}

build_adj_matrix <- function(adj_long, target_issuer) {
  if (is.null(adj_long) || nrow(adj_long) == 0) {
    return(data.frame(Type = character(), Sector = character(),
                      instrument = character(), counterparty_sector = character()))
  }
  
  if ("issuer_sector" %in% names(adj_long)) {
    adj_long <- adj_long %>% filter(issuer_sector == target_issuer)
  }
  
  issuance <- adj_long %>%
    filter(counterparty_sector == "000") %>%
    group_by(qtr) %>%
    summarise(adj_delta = sum(adj_delta, na.rm = TRUE), .groups = "drop") %>%
    mutate(
      Type = "L",
      Sector = target_issuer,
      instrument = "ALL",
      counterparty_sector = "000"
    )
  
  holders <- adj_long %>%
    filter(counterparty_sector != "000") %>%
    mutate(
      Type = "A",
      Sector = counterparty_sector
    )
  
  combined <- bind_rows(issuance, holders)
  
  if (nrow(combined) == 0) {
    return(data.frame(Type = character(), Sector = character(),
                      instrument = character(), counterparty_sector = character()))
  }
  
  mat <- build_wide_matrix(combined, "adj_delta",
                           c("Type", "Sector", "instrument", "counterparty_sector"))
  
  if (nrow(mat) == 0) {
    return(data.frame(Type = character(), Sector = character(),
                      instrument = character(), counterparty_sector = character()))
  }
  
  mat %>%
    arrange(Type != "L", Sector, instrument)
}

build_final_matrix <- function(source_data, adj_long, target_issuer, revision_win) {
  if (is.null(source_data) || nrow(source_data) == 0) {
    return(data.frame(Type = character(), Sector = character()))
  }
  
  source_df <- source_data %>%
    filter(issuer_sector == target_issuer) %>%
    filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
    mutate(qtr = parse_quarter_label(qtr)) %>%
    mutate(qtr_end = qtr_end_from_mmm_yy(qtr))
  
  if (nrow(source_df) == 0) {
    return(data.frame(Type = character(), Sector = character()))
  }
  
  if (!is.null(adj_long) && nrow(adj_long) > 0) {
    adj_for_issuer <- adj_long %>%
      filter(issuer_sector == target_issuer)
    
    source_df <- source_df %>%
      left_join(adj_for_issuer %>% select(-issuer_sector),
                by = c("inst_class", "instrument", "counterparty_sector", "qtr")) %>%
      mutate(
        in_window = qtr_end >= revision_win$start & qtr_end <= revision_win$end,
        adj_delta = coalesce(adj_delta, 0),
        effective_adj = if_else(in_window & counterparty_sector != "000", adj_delta, 0),
        final_value = value + effective_adj
      )
  } else {
    source_df <- source_df %>% mutate(final_value = value)
  }
  
  final_df <- source_df %>%
    group_by(counterparty_sector, qtr, qtr_end) %>%
    summarise(final_value = sum(final_value, na.rm = TRUE), .groups = "drop") %>%
    mutate(
      Type = if_else(counterparty_sector == "000", "L", "A"),
      Sector = if_else(counterparty_sector == "000", target_issuer, counterparty_sector)
    )
  
  mat <- build_wide_matrix(final_df, "final_value", c("Type", "Sector", "counterparty_sector"))
  if (nrow(mat) == 0) return(data.frame(Type = character(), Sector = character()))
  
  mat %>%
    arrange(Type != "L", Sector) %>%
    select(-counterparty_sector)
}

build_revisions_matrix <- function(current_data, old_data, target_issuer) {
  if (is.null(current_data) || nrow(current_data) == 0 ||
      is.null(old_data) || nrow(old_data) == 0) {
    return(data.frame(Type = character(), Sector = character(), Message = "No revision data available"))
  }
  
  cur <- current_data %>%
    filter(issuer_sector == target_issuer) %>%
    filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
    mutate(qtr = parse_quarter_label(qtr)) %>%
    group_by(counterparty_sector, qtr) %>%
    summarise(cur_value = sum(value, na.rm = TRUE), .groups = "drop")
  
  old <- old_data %>%
    filter(issuer_sector == target_issuer) %>%
    filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
    mutate(qtr = parse_quarter_label(qtr)) %>%
    group_by(counterparty_sector, qtr) %>%
    summarise(old_value = sum(value, na.rm = TRUE), .groups = "drop")
  
  if (nrow(cur) == 0) {
    return(data.frame(Type = character(), Sector = character(), Message = "No current data for this issuer"))
  }
  
  revisions <- cur %>%
    full_join(old, by = c("counterparty_sector", "qtr")) %>%
    mutate(
      cur_value = coalesce(cur_value, 0),
      old_value = coalesce(old_value, 0),
      revision = round(cur_value - old_value, 2),
      Type = if_else(counterparty_sector == "000", "L", "A"),
      Sector = if_else(counterparty_sector == "000", target_issuer, counterparty_sector)
    )
  
  mat <- build_wide_matrix(revisions, "revision", c("Type", "Sector", "counterparty_sector"))
  if (nrow(mat) == 0) return(data.frame(Type = character(), Sector = character()))
  
  mat %>%
    arrange(Type != "L", Sector) %>%
    select(-counterparty_sector)
}

add_qoq_columns <- function(wide_matrix) {
  if (is.null(wide_matrix) || nrow(wide_matrix) == 0) {
    return(wide_matrix)
  }
  
  all_cols <- names(wide_matrix)
  qtr_cols <- all_cols[grepl("^[A-Za-z]{3}-\\d{2}$", all_cols)]
  
  if (length(qtr_cols) < 2) {
    wide_matrix$Change <- NA
    wide_matrix$`% Chg` <- "-"
    return(wide_matrix)
  }
  
  qtr_dates <- qtr_end_from_mmm_yy(qtr_cols)
  qtr_order <- qtr_cols[order(qtr_dates)]
  
  curr_qtr <- qtr_order[length(qtr_order)]
  prev_qtr <- qtr_order[length(qtr_order) - 1]
  
  curr_vals <- if (curr_qtr %in% names(wide_matrix)) wide_matrix[[curr_qtr]] else NA
  prev_vals <- if (prev_qtr %in% names(wide_matrix)) wide_matrix[[prev_qtr]] else NA
  
  wide_matrix$Change <- round(curr_vals - prev_vals, 0)
  
  wide_matrix$`% Chg` <- sapply(seq_len(nrow(wide_matrix)), function(i) {
    prev_val <- prev_vals[i]
    curr_val <- curr_vals[i]
    if (is.na(prev_val) || is.na(curr_val) || prev_val == 0) return("-")
    pct <- ((curr_val - prev_val) / abs(prev_val)) * 100
    sprintf("%+.1f%%", pct)
  })
  
  wide_matrix
}

