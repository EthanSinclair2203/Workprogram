      Sector = if_else(counterparty_sector == "000", target_issuer, counterparty_sector)
    )
  
  if (nrow(df) == 0) return(data.frame(Type = character(), Sector = character()))
  
  mat <- build_wide_matrix(df, "value", c("Type", "Sector", "counterparty_sector"))
  if (nrow(mat) == 0) return(data.frame(Type = character(), Sector = character()))
  
  mat %>%
    arrange(Type != "T", Sector) %>%
