    if (!rowData) return null;

    var colHeader = table.column(idx.column).header();
    var quarter = $(colHeader).text();

    if (!quarter.match(/^[A-Za-z]{3}-\\d{2}$/)) return null;

    var tableId = tableEl.attr('id') || '';
    var panelType = detectPanel(tableEl);

    return {
      row: idx.row,
      col: idx.column,
      sector: rowData[1],
      type: rowData[0],
      quarter: quarter,
      panel: panelType,
      value: cell.data(),
      tableId: tableId
    };
  }

  function clearSelection() {
    $('.cell-selected').removeClass('cell-selected');
    window.selectedCells = [];
  }

  $(document).on('click', function(e) {
    if (!$(e.target).closest('#note-context-menu').length) {
      $('#note-context-menu').hide();
    }
  });

  setInterval(function() {
    $('tr.selected').removeClass('selected');
  }, 50);

  $(document).on('draw.dt', function() {
    $('.dataTable tbody tr.selected').removeClass('selected');
  });

  $(document).on('click', '.dataTable tbody td', function(e) {
    var td = this;
    var tableEl = $(td).closest('table');
    var tableId = tableEl.attr('id') || '';
    var isAdjTable = tableId.indexOf('adj') >= 0 && tableId.indexOf('resid') < 0;

    function clearRowSelection() {
      $('tr.selected').removeClass('selected');
      tableEl.find('tr.selected').removeClass('selected');
    }
    clearRowSelection();
    setTimeout(clearRowSelection, 0);
    setTimeout(clearRowSelection, 10);
    setTimeout(clearRowSelection, 50);
    setTimeout(clearRowSelection, 100);

    if (isAdjTable && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
      return true;
    }

    e.stopPropagation();
    e.stopImmediatePropagation();

    var cellInfo = getCellInfo(td);
    if (!cellInfo) {
      e.preventDefault();
      return false;
    }

    if (e.ctrlKey || e.metaKey) {
      $(td).toggleClass('cell-selected');
      if ($(td).hasClass('cell-selected')) {
        window.selectedCells.push(cellInfo);
      } else {
        window.selectedCells = window.selectedCells.filter(function(c) {
          return !(c.row === cellInfo.row && c.col === cellInfo.col && c.tableId === cellInfo.tableId);
        });
      }
    } else {
      clearSelection();
      $(td).addClass('cell-selected');
      window.selectedCells = [cellInfo];
    }

    e.preventDefault();
    return false;
  });

  $(document).on('click', '.dataTable tbody td', function(e) {
    if (!e.shiftKey) return;
    if (window.selectedCells.length === 0) return;

    e.stopPropagation();
    $(this).closest('tr').removeClass('selected');

    var table = $(this).closest('table').DataTable();
    var lastCell = window.selectedCells[window.selectedCells.length - 1];
    var cellInfo = getCellInfo(this);
    if (!cellInfo || lastCell.tableId !== cellInfo.tableId) return;

    var startCol = Math.min(lastCell.col, cellInfo.col);
    var endCol = Math.max(lastCell.col, cellInfo.col);
    var row = cellInfo.row;

    var tableEl = $(this).closest('table');
    for (var c = startCol; c <= endCol; c++) {
      var colHeader = table.column(c).header();
      if (isQuarterColumn(colHeader)) {
        var td = tableEl.find('tbody tr').eq(row).find('td').eq(c);
        if (!td.hasClass('cell-selected')) {
          td.addClass('cell-selected');
          var info = getCellInfo(td[0]);
          if (info) window.selectedCells.push(info);
        }
      }
    }

    return false;
  });

  $(document).on('contextmenu', '.dataTable tbody td', function(e) {
    e.preventDefault();

    var cellInfo = getCellInfo(this);
    if (!cellInfo) return;

    if (!$(this).hasClass('cell-selected')) {
      clearSelection();
      $(this).addClass('cell-selected');
      window.selectedCells = [cellInfo];
    }

    var contextData = {
      cells: window.selectedCells,
      count: window.selectedCells.length,
      ts: Date.now()
    };

    Shiny.setInputValue('note_context', contextData, {priority: 'event'});

    var countText = window.selectedCells.length > 1 ? ' (' + window.selectedCells.length + ' cells)' : '';
    $('#add-note-menu').html('<i class=\"fa fa-comment\"></i> Add Note' + countText);

    $('#note-context-menu').css({
      display: 'block',
      left: e.pageX,
      top: e.pageY
    });

    return false;
  });

  $(document).on('click', '#add-note-menu', function() {
    $('#note-context-menu').hide();
    Shiny.setInputValue('show_note_modal', Date.now(), {priority: 'event'});
  });

  $(document).on('click', '#view-notes-menu', function() {
    $('#note-context-menu').hide();
    Shiny.setInputValue('view_cell_notes', Date.now(), {priority: 'event'});
  });

  var tooltipTimeout;
  $(document).on('mouseenter', '.dataTable tbody td.has-note', function(e) {
    var td = this;
    var cellInfo = getCellInfo(td);
    if (!cellInfo) return;

    tooltipTimeout = setTimeout(function() {
      Shiny.setInputValue('hover_cell', {
        sector: cellInfo.sector,
        type: cellInfo.type,
        quarter: cellInfo.quarter,
        x: e.pageX,
        y: e.pageY,
        ts: Date.now()
      }, {priority: 'event'});
    }, 300);
  });

  $(document).on('mouseleave', '.dataTable tbody td.has-note', function() {
    clearTimeout(tooltipTimeout);
    $('#note-tooltip').hide();
  });

  $(document).on('keydown', function(e) {
    if (e.key === 'Escape') {
      clearSelection();
      $('#note-context-menu').hide();
    }
  });

  Shiny.addCustomMessageHandler('showNoteTooltip', function(data) {
    $('#note-tooltip').html(data.html).css({
      display: 'block',
      left: data.x + 10,
      top: data.y + 15
    });
  });

  Shiny.addCustomMessageHandler('hideNoteTooltip', function(data) {
    $('#note-tooltip').hide();
  });

  Shiny.addCustomMessageHandler('updateNoteCells', function(data) {
    Shiny.setInputValue('request_note_cells', {issuer: data.issuer, ts: Date.now()}, {priority: 'event'});
  });

  Shiny.addCustomMessageHandler('markNoteCells', function(data) {
    $('.dataTable tbody td.has-note').removeClass('has-note');

    if (data.cells && data.cells.length > 0) {
      data.cells.forEach(function(cell) {
        $('.shiny-html-output').each(function() {
          var outputId = $(this).attr('id') || '';
          var tableEl = $(this).find('.dataTable');
          if (tableEl.length === 0) return;

          var tablePanel = 'unknown';
          if (outputId === 'tbl_source') {
            tablePanel = 'source';
          } else if (outputId === 'tbl_adj') {
            tablePanel = 'adjustment';
          } else if (outputId === 'tbl_final') {
            tablePanel = 'final';
          } else if (outputId === 'tbl_rev') {
            tablePanel = 'revision';
          } else if (outputId === 'tbl_source_resid') {
            tablePanel = 'source_resid';
          } else if (outputId === 'tbl_adj_resid') {
            tablePanel = 'adj_resid';
          }

          if (cell.panel && cell.panel !== 'unknown' && tablePanel !== cell.panel) {
            return;
          }

          var table = tableEl.DataTable();
          var rows = table.rows().nodes();

          $(rows).each(function(rowIdx) {
            var rowData = table.row(rowIdx).data();
            if (!rowData) return;

            var sector = rowData[1];
            var type = rowData[0];
            var cpty = (type === 'L') ? '000' : sector;

            if (cpty === cell.counterparty) {
              table.columns().every(function(colIdx) {
                var header = $(this.header()).text();
                if (header === cell.quarter) {
                  $(table.cell(rowIdx, colIdx).node()).addClass('has-note');
                }
              });
            }
          });
        });
      });
    }
  });

  var adjTooltipTimeout;
  $(document).on('mouseenter', '#tbl_adj .dataTable tbody td', function(e) {
    var td = this;
    var tableEl = $(td).closest('table');
    var table = tableEl.DataTable();
    var cell = table.cell(td);
    var idx = cell.index();
    if (!idx) return;

    var rowData = table.row(idx.row).data();
    if (!rowData) return;

    var colHeader = table.column(idx.column).header();
    var quarter = $(colHeader).text();

    if (!quarter.match(/^[A-Za-z]{3}-\\d{2}$/)) return;

    var sector = rowData[1];
    var type = rowData[0];
    var cpty = (type === 'L') ? '000' : sector;
    var value = cell.data();

    if (cpty === '000') return;

    adjTooltipTimeout = setTimeout(function() {
      Shiny.setInputValue('adj_cell_hover', {
        counterparty: cpty,
        quarter: quarter,
        current_value: value,
        x: e.pageX,
        y: e.pageY,
        ts: Date.now()
      }, {priority: 'event'});
    }, 400);
  });

  $(document).on('mouseleave', '#tbl_adj .dataTable tbody td', function() {
    clearTimeout(adjTooltipTimeout);
    $('#adj-tooltip').hide();
  });

  Shiny.addCustomMessageHandler('showAdjTooltip', function(data) {
    $('#adj-tooltip').html(data.html).css({
      display: 'block',
      left: data.x + 10,
      top: data.y + 15
    });
  });

  Shiny.addCustomMessageHandler('hideAdjTooltip', function(data) {
    $('#adj-tooltip').hide();
  });

  Shiny.addCustomMessageHandler('markChangedCells', function(data) {
    $('#tbl_adj .dataTable tbody td.has-change').removeClass('has-change');

    if (data.cells && data.cells.length > 0) {
      var tableEl = $('#tbl_adj .dataTable');
      if (tableEl.length === 0) return;

      var table = tableEl.DataTable();
      var rows = table.rows().nodes();

      data.cells.forEach(function(cell) {
        $(rows).each(function(rowIdx) {
          var rowData = table.row(rowIdx).data();
          if (!rowData) return;

          var sector = rowData[1];
          var type = rowData[0];
          var cpty = (type === 'L') ? '000' : sector;

          if (cpty === cell.counterparty) {
            table.columns().every(function(colIdx) {
              var header = $(this.header()).text();
              if (header === cell.quarter) {
                $(table.cell(rowIdx, colIdx).node()).addClass('has-change');
              }
            });
          }
        });
      });
    }
  });
});
"

