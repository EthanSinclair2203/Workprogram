#' Parse quarter label to standardized format (MMM-YY)
parse_quarter_label <- function(x) {
  x <- str_trim(as.character(x))
  x <- str_replace_all(x, "\\s+", " ")
  x <- str_to_title(x)
  # Handle various formats: "Jun 88", "JUN 88", "Jun-88", "JUN-88"
  x <- str_replace(x, "^([A-Za-z]{3})\\s*[-]?\\s*(\\d{2})$", "\\1-\\2")
  x
}

#' Convert MMM-YY label to quarter-end Date
qtr_end_from_mmm_yy <- function(x) {
  x <- parse_quarter_label(x)
  d <- suppressWarnings(lubridate::parse_date_time(x, orders = "b-y", locale = "C"))
  if (any(is.na(d))) {
    warning("Failed to parse some quarter label(s). Expected format: 'Jun-88'")
    return(as.Date(rep(NA, length(x))))
  }
  ceiling_date(as.Date(d), "month") - days(1)
}

#' Format Date as MMM-YY label
format_mmm_yy <- function(d) {
  format(d, "%b-%y")
}

#' Calculate revision window based on edit quarter
#' - June edit quarter: 15 quarters back
#' - Other quarters: 8 quarters back
revision_window <- function(edit_qtr_end) {
  edit_qtr_end <- as.Date(edit_qtr_end)
  m <- month(edit_qtr_end)
  
  if (!m %in% c(3, 6, 9, 12)) {
    warning("Edit quarter is not a standard quarter-end month (Mar/Jun/Sep/Dec).")
  }
  
  n_qtrs <- if (m == 6) 15 else 8
  
  # Snap to quarter end, then subtract n_qtrs quarters
  edit_qtr_end <- ceiling_date(floor_date(edit_qtr_end, "quarter"), "quarter") - days(1)
  start_qtr_end <- edit_qtr_end %m-% months(3 * n_qtrs)
  
  list(start = start_qtr_end, end = edit_qtr_end, n_quarters = n_qtrs)
}

#' Safe grepl that handles NAs (returns FALSE for NA)
safe_grepl <- function(pattern, x, ...) {
  result <- grepl(pattern, x, ...)
  result[is.na(result) | is.na(x)] <- FALSE
  result
}

#' Get ordered quarter labels from dates
get_ordered_quarters <- function(qtr_labels) {
  valid <- qtr_labels[safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr_labels)]
  if (length(valid) == 0) return(character(0))
  
  dates <- qtr_end_from_mmm_yy(valid)
  valid[order(dates)]
}

# ============================================================
# PART 03 — LIABILITY CODE PARSING
#   Format: L.<class>.<instrument>.L.<issuer>.<counterparty>
#   Example: L.B.420.L.111.233
# ============================================================

CODE_REGEX <- "^L\\.([A-Za-z])\\.(\\d{3})\\.L\\.(\\d{3})\\.(\\d{3})$"

#' Parse liability code into components
parse_code_parts <- function(code_chr) {
  m <- str_match(code_chr, CODE_REGEX)
  tibble(
    inst_class = m[, 2],
    instrument = m[, 3],
    issuer_sector = sprintf("%03d", as.integer(m[, 4])),
    counterparty_sector = sprintf("%03d", as.integer(m[, 5]))
  )
}

#' Validate if string is a valid liability code
is_valid_code <- function(code_chr) {
  result <- str_detect(code_chr, CODE_REGEX)
  result[is.na(result)] <- FALSE
  result
}

