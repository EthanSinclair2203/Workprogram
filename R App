ensure_notes_file <- function(path) {
  if (!file.exists(path)) {
    dir.create(dirname(path), showWarnings = FALSE, recursive = TRUE)
    write.csv(
      data.frame(
        note_type = character(),      # "movement" or "adjustment"
        issuer_sector = character(),
        counterparty_sector = character(),
        qtr = character(),
        panel = character(),          # "source", "adjustment", "final", "revision"
        note_text = character(),
        created_by = character(),
        created_at = character(),
        stringsAsFactors = FALSE
      ),
      path,
      row.names = FALSE
    )
  }
}

read_notes_log <- function(path) {
  ensure_notes_file(path)
  df <- tryCatch(read.csv(path, stringsAsFactors = FALSE), error = function(e) NULL)
  
  if (is.null(df) || nrow(df) == 0) {
    return(tibble(
      note_type = character(),
      issuer_sector = character(),
      counterparty_sector = character(),
      qtr = character(),
      panel = character(),
      note_text = character(),
      created_by = character(),
      created_at = character()
    ))
  }
  
  if (!"panel" %in% names(df)) {
    df$panel <- "unknown"
  }
  
  as_tibble(df) %>%
    mutate(
      note_type = as.character(note_type),
      issuer_sector = sprintf("%03d", as.integer(issuer_sector)),
      counterparty_sector = sprintf("%03d", as.integer(counterparty_sector)),
      qtr = as.character(qtr),
      panel = as.character(panel),
      note_text = as.character(note_text),
      created_by = as.character(created_by),
      created_at = as.character(created_at)
    )
}

add_note <- function(path, note_type, issuer_sector, counterparty_sector, qtr, panel, note_text, created_by = "") {
  ensure_notes_file(path)
  row <- data.frame(
    note_type = note_type,
    issuer_sector = issuer_sector,
    counterparty_sector = counterparty_sector,
    qtr = qtr,
    panel = panel,
    note_text = note_text,
    created_by = created_by,
    created_at = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
    stringsAsFactors = FALSE
  )
  write.table(row, path, sep = ",", col.names = FALSE, row.names = FALSE, append = TRUE)
}

get_notes_for_issuer <- function(notes_log, issuer_sector) {
  if (nrow(notes_log) == 0) return(notes_log)
  
  notes_log %>%
    filter(issuer_sector == !!issuer_sector) %>%
    arrange(desc(created_at))
}

get_latest_note <- function(notes_log, issuer_sector, counterparty_sector, qtr, note_type = NULL) {
  if (nrow(notes_log) == 0) return(NULL)
  
  filtered <- notes_log %>%
    filter(
      issuer_sector == !!issuer_sector,
      counterparty_sector == !!counterparty_sector,
      qtr == !!qtr
    )
  
  if (!is.null(note_type)) {
    filtered <- filtered %>% filter(note_type == !!note_type)
  }
  
  if (nrow(filtered) == 0) return(NULL)
  
  filtered %>%
    arrange(desc(created_at)) %>%
    slice(1)
}

