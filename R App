# PART 04 — EXCEL INGESTION
# ============================================================

#' Detect quarter label row in Excel header
detect_quarter_row <- function(path, sheet, max_rows = 10) {
  hdr <- read_excel(path, sheet = sheet, col_names = FALSE, n_max = max_rows)
  
  qtr_pattern <- "^[A-Za-z]{3}\\s*[-]?\\s*\\d{2}$"
  
  best_row <- 1
  best_count <- 0
  
  for (i in 1:nrow(hdr)) {
    row_vals <- as.character(hdr[i, ])
    matches <- sum(str_detect(row_vals, qtr_pattern), na.rm = TRUE)
    if (matches > best_count) {
      best_count <- matches
      best_row <- i
    }
  }
  
  best_row
}

#' Build long-format time series from Excel sheet
build_long_from_sheet <- function(path, sheet, header_row = NULL) {
  
  if (is.null(header_row)) {
    header_row <- detect_quarter_row(path, sheet)
  }
  
  hdr <- read_excel(path, sheet = sheet, col_names = FALSE, skip = header_row - 1, n_max = 1)
  raw <- read_excel(path, sheet = sheet, col_names = FALSE, skip = header_row)
  
  if (nrow(raw) == 0) {
    return(tibble(
      inst_class = character(),
      instrument = character(),
      issuer_sector = character(),
      counterparty_sector = character(),
      qtr = character(),
      value = double()
    ))
  }
  
  code_col_idx <- NULL
  for (i in 1:min(10, ncol(raw))) {
    col_vals <- as.character(raw[[i]])
    match_rate <- mean(is_valid_code(col_vals), na.rm = TRUE)
    if (match_rate >= 0.15) {
      code_col_idx <- i
      break
    }
  }
  
  if (is.null(code_col_idx)) {
    warning(paste0("Could not detect liability code column on sheet '", sheet, "'."))
    return(tibble(
      inst_class = character(),
      instrument = character(),
      issuer_sector = character(),
      counterparty_sector = character(),
      qtr = character(),
      value = double()
    ))
  }
  
  qtr_pattern <- "^[A-Za-z]{3}\\s*[-]?\\s*\\d{2}$"
  qtr_col_indices <- c()
  qtr_labels <- c()
  
  for (i in (code_col_idx + 1):ncol(raw)) {
    col_vals <- raw[[i]]
    numeric_vals <- suppressWarnings(as.numeric(as.character(col_vals)))
    numeric_rate <- mean(!is.na(numeric_vals), na.rm = TRUE)
    
    header_val <- if (i <= ncol(hdr)) as.character(hdr[[i]]) else ""
    header_val <- ifelse(is.na(header_val), "", header_val)
    is_qtr_header <- str_detect(header_val, qtr_pattern)
    is_qtr_header <- isTRUE(is_qtr_header)
    
    if (numeric_rate >= 0.20 || is_qtr_header) {
      qtr_col_indices <- c(qtr_col_indices, i)
      if (is_qtr_header) {
        qtr_labels <- c(qtr_labels, parse_quarter_label(header_val))
      } else {
        qtr_labels <- c(qtr_labels, paste0("Q", length(qtr_col_indices)))
      }
    }
  }
  
  if (length(qtr_col_indices) == 0) {
    warning(paste0("No quarter columns detected on sheet '", sheet, "'."))
    return(tibble(
      inst_class = character(),
      instrument = character(),
      issuer_sector = character(),
      counterparty_sector = character(),
      qtr = character(),
      value = double()
    ))
  }
  
  df <- raw %>%
    select(all_of(c(code_col_idx, qtr_col_indices))) %>%
    setNames(c("code", qtr_labels)) %>%
    mutate(code = as.character(code)) %>%
    filter(is_valid_code(code))
  
  if (nrow(df) == 0) {
    return(tibble(
      inst_class = character(),
      instrument = character(),
      issuer_sector = character(),
      counterparty_sector = character(),
      qtr = character(),
      value = double()
    ))
  }
  
  df_long <- df %>%
    pivot_longer(-code, names_to = "qtr", values_to = "value") %>%
    mutate(
      qtr = parse_quarter_label(qtr),
      value = suppressWarnings(as.numeric(as.character(value)))
    ) %>%
    filter(!is.na(value), safe_grepl("^[A-Za-z]{3}-\\d{2}$", qtr))
  
  parts <- parse_code_parts(df_long$code)
  
  bind_cols(df_long %>% select(-code), parts) %>%
    select(inst_class, instrument, issuer_sector, counterparty_sector, qtr, value) %>%
    arrange(inst_class, instrument, issuer_sector, counterparty_sector, qtr)
}

#' Discover relevant sheets in workbook
discover_sheets <- function(path) {
  sheets <- excel_sheets(path)
  sheets_lower <- tolower(sheets)
  
  safe_detect <- function(x, pattern) {
    result <- str_detect(x, pattern)
    result[is.na(result)] <- FALSE
    result
  }
  
  levels_current <- NULL
  levels_old <- NULL
  
  current_patterns <- c("et27l_millions$", "et27l$", "levels$", "current")
  for (pat in current_patterns) {
    matches <- sheets[safe_detect(sheets_lower, pat) & !safe_detect(sheets_lower, "old|prev")]
    if (length(matches) > 0) {
      levels_current <- matches[1]
      break
    }
  }
  
  old_patterns <- c("et27l_millions_old", "et27l_millions_prev", "old", "prev")
  for (pat in old_patterns) {
    matches <- sheets[safe_detect(sheets_lower, pat)]
    if (length(matches) > 0) {
      levels_old <- matches[1]
      break
    }
  }
  
  if (is.null(levels_current)) {
    levels_current <- sheets[1]
  }
  
  list(
    levels_current = levels_current,
    levels_old = levels_old,
    all_sheets = sheets
  )
}

#' Load all data from a workbook
load_workbook <- function(path) {
  sheets <- discover_sheets(path)
  
  levels_cur <- tryCatch(
    build_long_from_sheet(path, sheets$levels_current) %>% mutate(vintage = "current"),
    error = function(e) {
      warning(paste0("Error loading current levels: ", e$message))
      tibble(inst_class = character(), instrument = character(),
             issuer_sector = character(), counterparty_sector = character(),
             qtr = character(), value = double(), vintage = character())
    }
  )
  
  levels_old <- if (!is.null(sheets$levels_old)) {
    tryCatch(
      build_long_from_sheet(path, sheets$levels_old) %>% mutate(vintage = "old"),
      error = function(e) {
        warning(paste0("Error loading old levels: ", e$message))
        tibble(inst_class = character(), instrument = character(),
               issuer_sector = character(), counterparty_sector = character(),
               qtr = character(), value = double(), vintage = character())
      }
    )
  } else {
    tibble(inst_class = character(), instrument = character(),
           issuer_sector = character(), counterparty_sector = character(),
           qtr = character(), value = double(), vintage = character())
  }
  
  list(
    current = levels_cur,
    old = levels_old,
    sheets = sheets
  )
}

#' Load all workbooks from a folder
load_all_workbooks <- function(folder_path) {
  xlsx_files <- list.files(folder_path, pattern = "\\.xlsx$", full.names = TRUE)
  
  if (length(xlsx_files) == 0) {
    return(list(
      current = tibble(inst_class = character(), instrument = character(),
                       issuer_sector = character(), counterparty_sector = character(),
                       qtr = character(), value = double(), vintage = character()),
      old = tibble(inst_class = character(), instrument = character(),
                   issuer_sector = character(), counterparty_sector = character(),
                   qtr = character(), value = double(), vintage = character()),
      files = character()
    ))
  }
  
  all_current <- list()
  all_old <- list()
  
  for (f in xlsx_files) {
    wb_data <- load_workbook(f)
    all_current[[f]] <- wb_data$current
    all_old[[f]] <- wb_data$old
  }
  
  list(
    current = bind_rows(all_current),
    old = bind_rows(all_old),
    files = basename(xlsx_files)
  )
}

# ============================================================
# PART 05 — ADJUSTMENTS LOG MANAGEMENT
# ============================================================

ensure_log_file <- function(path) {
  if (!file.exists(path)) {
    dir.create(dirname(path), showWarnings = FALSE, recursive = TRUE)
    write.csv(
      data.frame(
        inst_class = character(),
        instrument = character(),
        issuer_sector = character(),
        counterparty_sector = character(),
        qtr = character(),
        adj_delta = numeric(),
        asof = character(),
        stringsAsFactors = FALSE
      ),
      path,
      row.names = FALSE
    )
  }
}

read_adjustments_log <- function(path) {
  ensure_log_file(path)
  df <- tryCatch(read.csv(path, stringsAsFactors = FALSE), error = function(e) NULL)
  
  empty_result <- tibble(
    inst_class = character(),
    instrument = character(),
    issuer_sector = character(),
    counterparty_sector = character(),
    qtr = character(),
    adj_delta = double(),
    asof = character()
  )
  
  if (is.null(df) || nrow(df) == 0) {
    return(empty_result)
  }
  
  required_cols <- c("inst_class", "instrument", "issuer_sector", "counterparty_sector", "qtr", "adj_delta", "asof")
  if (!all(required_cols %in% names(df))) {
    message("Adjustments log missing required columns. Found: ", paste(names(df), collapse = ", "))
    return(empty_result)
  }
  
  tryCatch({
    as_tibble(df) %>%
      mutate(
        inst_class = as.character(inst_class),
        instrument = as.character(instrument),
        issuer_sector = sprintf("%03d", as.integer(issuer_sector)),
        counterparty_sector = sprintf("%03d", as.integer(counterparty_sector)),
        qtr = as.character(qtr),
        adj_delta = as.numeric(adj_delta),
        asof = as.character(asof)
      )
  }, error = function(e) {
    message("Error parsing adjustments log: ", e$message)
    empty_result
  })
}

append_adjustment <- function(path, inst_class, instrument, issuer_sector,
                              counterparty_sector, qtr, adj_delta) {
  ensure_log_file(path)
  row <- data.frame(
    inst_class = inst_class,
    instrument = instrument,
    issuer_sector = issuer_sector,
    counterparty_sector = counterparty_sector,
    qtr = qtr,
    adj_delta = as.numeric(adj_delta),
    asof = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
    stringsAsFactors = FALSE
  )
  write.table(row, path, sep = ",", col.names = FALSE, row.names = FALSE, append = TRUE)
}

latest_adjustments <- function(adj_log) {
  if (nrow(adj_log) == 0) {
    return(tibble(
      inst_class = character(),
      instrument = character(),
      issuer_sector = character(),
      counterparty_sector = character(),
      qtr = character(),
      adj_delta = double()
    ))
  }
  
  adj_log <- adj_log %>%
    filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
    mutate(qtr = parse_quarter_label(qtr))
  
  if (nrow(adj_log) == 0) {
    return(tibble(
      inst_class = character(),
      instrument = character(),
      issuer_sector = character(),
      counterparty_sector = character(),
      qtr = character(),
      adj_delta = double()
    ))
  }
  
  adj_log %>%
    mutate(
      qtr_end = qtr_end_from_mmm_yy(qtr),
      asof_ts = suppressWarnings(as.POSIXct(asof, tz = "UTC"))
    ) %>%
    arrange(inst_class, instrument, issuer_sector, counterparty_sector,
            qtr_end, desc(asof_ts)) %>%
    distinct(inst_class, instrument, issuer_sector, counterparty_sector, qtr,
             .keep_all = TRUE) %>%
    select(inst_class, instrument, issuer_sector, counterparty_sector, qtr, adj_delta)
}

# ============================================================
# PART 06 — QUARTER-END SNAPSHOTS
# ============================================================

create_quarter_snapshot <- function(current_data, adj_log_path, snapshot_dir,
                                    quarter_label, notes = "", files_loaded = character(),
                                    notes_log_path = NULL) {
  
  if (is.null(current_data) || nrow(current_data) == 0) {
    stop("No current data to snapshot")
  }
  
  dir.create(snapshot_dir, showWarnings = FALSE, recursive = TRUE)
  
  adj_log <- read_adjustments_log(adj_log_path)
  
  if (!"notes" %in% names(adj_log)) {
    adj_log$notes <- ""
  }
  
  quarter_date <- qtr_end_from_mmm_yy(quarter_label)
  revision_win <- revision_window(quarter_date)
  
  issuers <- unique(current_data$issuer_sector)
  issuers <- issuers[issuers != "000"]
  
  all_final_data <- list()
  
  for (iss in issuers) {
    adj_for_issuer <- adj_log %>%
      filter(issuer_sector == iss)
    
    source_df <- current_data %>%
      filter(issuer_sector == iss) %>%
      filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
      mutate(qtr_end = qtr_end_from_mmm_yy(qtr))
    
    if (nrow(source_df) == 0) next
    
    if (nrow(adj_for_issuer) > 0) {
      adj_latest <- adj_for_issuer %>%
        mutate(asof_ts = suppressWarnings(as.POSIXct(asof, tz = "UTC"))) %>%
        arrange(inst_class, instrument, counterparty_sector, qtr, desc(asof_ts)) %>%
        distinct(inst_class, instrument, counterparty_sector, qtr, .keep_all = TRUE)
      
      source_df <- source_df %>%
        left_join(
          adj_latest %>%
            select(inst_class, instrument, counterparty_sector, qtr, adj_delta, notes),
          by = c("inst_class", "instrument", "counterparty_sector", "qtr")
        ) %>%
        mutate(
          in_window = qtr_end >= revision_win$start & qtr_end <= revision_win$end,
          adj_delta = coalesce(adj_delta, 0),
          effective_adj = if_else(in_window & counterparty_sector != "000", adj_delta, 0),
          final_value = value + effective_adj,
          adj_notes = coalesce(notes, "")
        )
    } else {
      source_df <- source_df %>%
        mutate(
          adj_delta = 0,
          effective_adj = 0,
          final_value = value,
          adj_notes = ""
        )
    }
    
    final_detail <- source_df %>%
      select(inst_class, instrument, issuer_sector, counterparty_sector,
             qtr, qtr_end, value, adj_delta, effective_adj, final_value,
             vintage, adj_notes)
    
    all_final_data[[iss]] <- final_detail
  }
  
  timestamp <- format(Sys.time(), "%Y%m%d_%H%M%S")
  snapshot_filename <- paste0("ET27_Snapshot_", quarter_label, "_", timestamp, ".xlsx")
  snapshot_path <- file.path(snapshot_dir, snapshot_filename)
  
  wb <- openxlsx::createWorkbook()
  
  if (length(all_final_data) > 0) {
    final_combined <- bind_rows(all_final_data)
    openxlsx::addWorksheet(wb, "Final_Data")
    openxlsx::writeData(wb, "Final_Data", final_combined)
  }
  
  openxlsx::addWorksheet(wb, "Adjustments_Log")
  openxlsx::writeData(wb, "Adjustments_Log", adj_log)
  
  metadata <- data.frame(
    Quarter = quarter_label,
    Snapshot_Date = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
    Revision_Window_Start = format_mmm_yy(revision_win$start),
    Revision_Window_End = format_mmm_yy(revision_win$end),
    Number_of_Issuers = length(issuers),
    Total_Adjustments = nrow(adj_log),
    Notes = notes,
    Source_Files = paste(files_loaded, collapse = "; "),
    stringsAsFactors = FALSE
  )
  openxlsx::addWorksheet(wb, "Metadata")
  openxlsx::writeData(wb, "Metadata", metadata)
  
  summary_list <- list()
  for (iss in issuers) {
    if (is.null(all_final_data[[iss]])) next
    
    summary_df <- all_final_data[[iss]] %>%
      group_by(counterparty_sector, qtr) %>%
      summarise(
        Source_Value = sum(value, na.rm = TRUE),
        Total_Adjustments = sum(effective_adj, na.rm = TRUE),
        Final_Value = sum(final_value, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      mutate(
        Issuer_Sector = iss,
        Type = if_else(counterparty_sector == "000", "L", "A"),
        Sector = if_else(counterparty_sector == "000", iss, counterparty_sector)
      ) %>%
      select(Issuer_Sector, Type, Sector, Quarter = qtr, Source_Value,
             Total_Adjustments, Final_Value)
    
    summary_list[[iss]] <- summary_df
  }
  
  if (length(summary_list) > 0) {
    summary_combined <- bind_rows(summary_list)
    openxlsx::addWorksheet(wb, "Summary_by_Issuer")
    openxlsx::writeData(wb, "Summary_by_Issuer", summary_combined)
  }
  
  if (!is.null(notes_log_path) && file.exists(notes_log_path)) {
    notes_log <- tryCatch(read_notes_log(notes_log_path), error = function(e) NULL)
    if (!is.null(notes_log) && nrow(notes_log) > 0) {
      openxlsx::addWorksheet(wb, "Notes_Log")
      openxlsx::writeData(wb, "Notes_Log", notes_log)
    }
  }
  
  openxlsx::saveWorkbook(wb, snapshot_path, overwrite = TRUE)
  
  index_path <- file.path(snapshot_dir, "snapshot_index.csv")
  if (file.exists(index_path)) {
    index_df <- read.csv(index_path, stringsAsFactors = FALSE)
  } else {
    index_df <- data.frame(
      Snapshot_File = character(),
      Quarter = character(),
      Snapshot_Date = character(),
      Notes = character(),
      stringsAsFactors = FALSE
    )
  }
  
  new_entry <- data.frame(
    Snapshot_File = snapshot_filename,
    Quarter = quarter_label,
    Snapshot_Date = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
    Notes = notes,
    stringsAsFactors = FALSE
  )
  
  index_df <- rbind(index_df, new_entry)
  write.csv(index_df, index_path, row.names = FALSE)
  
  return(list(
    path = snapshot_path,
    filename = snapshot_filename,
    timestamp = timestamp
  ))
}

list_snapshots <- function(snapshot_dir) {
  if (is.null(snapshot_dir) || snapshot_dir == "" || !dir.exists(snapshot_dir)) {
    return(data.frame(
      Snapshot_File = character(),
      Quarter = character(),
      Snapshot_Date = character(),
      Notes = character(),
      stringsAsFactors = FALSE
    ))
  }
  
  index_path <- file.path(snapshot_dir, "snapshot_index.csv")
  if (!file.exists(index_path)) {
    return(data.frame(
      Snapshot_File = character(),
      Quarter = character(),
      Snapshot_Date = character(),
      Notes = character(),
      stringsAsFactors = FALSE
    ))
  }
  
  tryCatch({
    read.csv(index_path, stringsAsFactors = FALSE) %>%
      arrange(desc(Snapshot_Date))
  }, error = function(e) {
    data.frame(
      Snapshot_File = character(),
      Quarter = character(),
      Snapshot_Date = character(),
      Notes = character(),
      stringsAsFactors = FALSE
    )
  })
}

load_snapshot <- function(snapshot_path) {
  if (!file.exists(snapshot_path)) {
    stop("Snapshot file not found")
  }
  
  result <- list()
  
  tryCatch({
    result$final_data <- readxl::read_excel(snapshot_path, sheet = "Final_Data")
  }, error = function(e) {
    result$final_data <- NULL
  })
  
  tryCatch({
    result$adjustments_log <- readxl::read_excel(snapshot_path, sheet = "Adjustments_Log")
  }, error = function(e) {
    result$adjustments_log <- NULL
  })
  
  tryCatch({
    result$metadata <- readxl::read_excel(snapshot_path, sheet = "Metadata")
  }, error = function(e) {
    result$metadata <- NULL
  })
  
  tryCatch({
    result$summary <- readxl::read_excel(snapshot_path, sheet = "Summary_by_Issuer")
  }, error = function(e) {
    result$summary <- NULL
  })
  
  if (!is.null(result$final_data) && nrow(result$final_data) > 0) {
    result$final_data <- result$final_data %>%
      mutate(
        inst_class = as.character(inst_class),
        instrument = as.character(instrument),
        issuer_sector = sprintf("%03d", as.integer(issuer_sector)),
        counterparty_sector = sprintf("%03d", as.integer(counterparty_sector)),
        qtr = as.character(qtr),
        value = as.numeric(value),
        adj_delta = as.numeric(adj_delta),
        effective_adj = as.numeric(effective_adj),
        final_value = as.numeric(final_value),
        vintage = as.character(vintage)
      )
  }
  
  if (!is.null(result$adjustments_log) && nrow(result$adjustments_log) > 0) {
    result$adjustments_log <- result$adjustments_log %>%
      mutate(
        inst_class = as.character(inst_class),
        instrument = as.character(instrument),
        issuer_sector = sprintf("%03d", as.integer(issuer_sector)),
        counterparty_sector = sprintf("%03d", as.integer(counterparty_sector)),
        qtr = as.character(qtr),
        adj_delta = as.numeric(adj_delta),
        asof = as.character(asof)
      )
  }
  
  result
}

