build_wide_matrix <- function(df_long, value_col = "value", row_cols = c("counterparty_sector")) {
  if (nrow(df_long) == 0) {
    return(data.frame())
  }
  
  df_long <- df_long %>%
    filter(safe_grepl("^[A-Za-z]{3}[-]?\\d{2}$", qtr)) %>%
    mutate(qtr = parse_quarter_label(qtr)) %>%
    mutate(qtr_end = qtr_end_from_mmm_yy(qtr))
  
  if (nrow(df_long) == 0) {
    return(data.frame())
  }
  
  qtr_order <- df_long %>%
    distinct(qtr, qtr_end) %>%
    arrange(qtr_end) %>%
    pull(qtr)
  
  df_long %>%
    select(all_of(row_cols), qtr, all_of(value_col)) %>%
    pivot_wider(names_from = qtr, values_from = all_of(value_col),
                values_fn = sum, values_fill = 0) %>%
    select(all_of(row_cols), all_of(qtr_order))
}

build_source_matrix <- function(source_data, target_issuer) {
  if (is.null(source_data) || nrow(source_data) == 0) {
    return(data.frame(Type = character(), Sector = character()))
  }
  
  df <- source_data %>%
    filter(issuer_sector == target_issuer) %>%
    group_by(counterparty_sector, qtr) %>%
    summarise(value = sum(value, na.rm = TRUE), .groups = "drop") %>%
    mutate(
      Type = if_else(counterparty_sector == "000", "L", "A"),
      Sector = if_else(counterparty_sector == "000", target_issuer, counterparty_sector)
    )
  
  if (nrow(df) == 0) return(data.frame(Type = character(), Sector = character()))
  
  mat <- build_wide_matrix(df, "value", c("Type", "Sector", "counterparty_sector"))
  if (nrow(mat) == 0) return(data.frame(Type = character(), Sector = character()))
  
  mat %>%
    arrange(Type != "L", Sector) %>%
    select(-counterparty_sector)
}

build_transactions_matrix <- function(source_data, target_issuer) {
  if (is.null(source_data) || nrow(source_data) == 0) {
    return(data.frame(Type = character(), Sector = character()))
  }
  
  df <- source_data %>%
