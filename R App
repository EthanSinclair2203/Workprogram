                 panel == "adjustment") %>%
          arrange(desc(created_at))
        if (nrow(cell_notes) > 0) notes_text <- cell_notes$note_text[1]
      }
    }
    
    fmt_baseline <- format(baseline_val, big.mark = ",", nsmall = 0)
    fmt_current <- format(current_val, big.mark = ",", nsmall = 0)
    fmt_delta <- paste0(ifelse(delta >= 0, "+", ""), format(delta, big.mark = ",", nsmall = 0))
    delta_class <- if (delta > 0) "positive" else if (delta < 0) "negative" else ""
    
    tooltip_html <- paste0(
      '<div class="adj-tooltip-row">',
      '<span class="adj-tooltip-label">Original (baseline):</span>',
      '<span class="adj-tooltip-value">', fmt_baseline, '</span>',
      '</div>',
      '<div class="adj-tooltip-row">',
      '<span class="adj-tooltip-label">Current:</span>',
      '<span class="adj-tooltip-value">', fmt_current, '</span>',
      '</div>',
      '<div class="adj-tooltip-row">',
      '<span class="adj-tooltip-label">Change this quarter:</span>',
      '<span class="adj-tooltip-value ', delta_class, '">', fmt_delta, '</span>',
      '</div>'
    )
    
    if (nchar(notes_text) > 0) {
      tooltip_html <- paste0(
        tooltip_html,
        '<div class="adj-tooltip-notes">',
        '<strong>Notes:</strong> ', htmltools::htmlEscape(notes_text),
        '</div>'
      )
    }
    
    session$sendCustomMessage("showAdjTooltip", list(
      html = tooltip_html,
      x = hover$x,
      y = hover$y
    ))
  })
  
  mark_changed_cells <- function() {
    iss <- selected_iss()
    if (is.null(iss)) return()
    
    adj_state <- rv$adj_state[[iss]]
    adj_baseline <- rv$adj_baseline[[iss]]
    
    if (is.null(adj_state) || is.null(adj_baseline) ||
        nrow(adj_state) == 0 || nrow(adj_baseline) == 0) {
      session$sendCustomMessage("markChangedCells", list(cells = list()))
      return()
    }
    
    comparison <- adj_state %>%
      select(counterparty_sector, qtr, adj_delta) %>%
      left_join(adj_baseline %>% select(counterparty_sector, qtr, baseline),
                by = c("counterparty_sector", "qtr")) %>%
      mutate(
        baseline = coalesce(baseline, 0),
        adj_delta = coalesce(adj_delta, 0)
      ) %>%
      filter(adj_delta != baseline, counterparty_sector != "000") %>%
      distinct(counterparty_sector, qtr)
    
    if (nrow(comparison) == 0) {
      session$sendCustomMessage("markChangedCells", list(cells = list()))
      return()
    }
    
    cells_list <- lapply(seq_len(nrow(comparison)), function(i) {
      list(counterparty = comparison$counterparty_sector[i], quarter = comparison$qtr[i])
    })
    
    session$sendCustomMessage("markChangedCells", list(cells = cells_list))
  }
  
